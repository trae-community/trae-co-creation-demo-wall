# ========================================
# TRAE Demo Wall — Docker Compose 部署
# ========================================
# cp .env.docker.example .env
# docker compose -f docker-compose.prod.yml up -d --build
#
# 本文件只需填写 compose 从宿主机 .env 注入的变量。
# DATABASE_URL / REDIS_URL / AUTH_TRUST_HOST / RUN_DB_INIT 等已在
# docker-compose*.yml 里写死，不要在这里重复配置。
# ========================================

# NextAuth（必填）
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
# 对外访问地址（走 Nginx 一般为 80 端口）
NEXTAUTH_URL="http://localhost:80"

# 腾讯云 COS（必填；构建镜像与运行时都会用到）
COS_SECRET_ID="your-cos-secret-id"
COS_SECRET_KEY="your-cos-secret-key"
COS_BUCKET="your-bucket-name"
COS_REGION="ap-guangzhou"

# ----------------------------------------
# 可选
# ----------------------------------------
# Nginx 反代后建议开启（compose 默认 TRUST_PROXY=1，一般无需改）
# TRUST_PROXY=1
# AUTH_SESSION_MAX_AGE=604800
# AUTH_SESSION_UPDATE_AGE=86400

# 盲盒入口需在 next build 时打进前端；若用 Docker 构建且需开启，在 compose build args
# 或构建前 export，见 Dockerfile / compose 注释。运行时改 .env 对已构建镜像无效。
