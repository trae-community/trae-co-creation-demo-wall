# ========================================
# TRAE Demo Wall - Docker Compose 环境配置
# ========================================
# 使用方法：复制此文件为 .env 并在 docker compose up 前使用
# cp .env.docker.example .env
# docker compose up -d
# ========================================

# ----------------------------------------
# Database (PostgreSQL)
# ----------------------------------------
# Docker Compose 内部连接（容器间通信）
DATABASE_URL="postgresql://postgres:postgres@db:5432/trae_demo_wall?schema=public&connection_limit=20&pool_timeout=20"
DIRECT_URL="postgresql://postgres:postgres@db:5432/trae_demo_wall"

# 本地开发访问（宿主机连接开发库 db-dev，端口 5433）
# DATABASE_URL_LOCAL="postgresql://postgres:postgres@localhost:5433/trae_demo_wall_dev"

# ----------------------------------------
# Redis
# ----------------------------------------
# Docker Compose 内部连接
REDIS_URL="redis://redis:6379"

# ----------------------------------------
# NextAuth Authentication
# ----------------------------------------
# ⚠️ 生产环境务必更改此值!
# 生成方式: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
# 线上域名请修改为实际 URL（默认走 compose 内置 nginx，端口 80）
NEXTAUTH_URL="http://localhost:80"
# 如直连 app 容器（端口 3000），则使用: http://localhost:3000

# ----------------------------------------
# Tencent Cloud COS (对象存储)
# ----------------------------------------
# 用于文件上传功能（作品封面、头像等）
COS_SECRET_ID="your-cos-secret-id"
COS_SECRET_KEY="your-cos-secret-key"
COS_BUCKET="your-bucket-name"      # 例如: traedemo-1300167186
COS_REGION="ap-guangzhou"          # ap-beijing, ap-shanghai, etc.

# ----------------------------------------
# Application Settings
# ----------------------------------------
NODE_ENV="production"

# ----------------------------------------
# Container Settings
# ----------------------------------------
# 数据库初始化开关（仅在 app-init 容器中使用，自动执行迁移+种子）
RUN_DB_INIT=true

# 应用启动开关（仅在 app-init 容器中使用）
START_SERVER=false
