# ========================================
# TRAE Demo Wall — 本地开发
# ========================================
# 复制为 .env（或 .env.local），与 `npm run dev` 同目录。
# 仅需下列变量即可跑通；其余为可选调优（见文末注释）。
# ========================================

# PostgreSQL（Prisma 必填）
# 推荐：docker compose up -d db-dev 后使用 5433 开发库（见 README）
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/trae_demo_wall_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/trae_demo_wall_dev"

# NextAuth（必填）
# NEXTAUTH_SECRET 生成: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# 腾讯云 COS — 封面上传/头像（必填，否则 /api/file、/api/avatar 失败）
COS_SECRET_ID="your-cos-secret-id"
COS_SECRET_KEY="your-cos-secret-key"
COS_BUCKET="your-bucket-name"
COS_REGION="ap-guangzhou"

# 首页「1024 代码盲盒」入口（可选，默认 false）
NEXT_PUBLIC_CODE_BLIND_BOX_ENABLED="true"

# ----------------------------------------
# 可选（代码中有读取，不设则用默认值）
# ----------------------------------------
# PRISMA_LOG_QUERIES=1
# DICT_CACHE_TTL_MS=60000
# FILTER_OPTIONS_CACHE_TTL_MS=60000
# COS_IMAGE_HOST=your-bucket.cos.ap-guangzhou.myqcloud.com
# TRUST_PROXY=1
# AUTH_SESSION_MAX_AGE=604800
# AUTH_SESSION_UPDATE_AGE=86400
# UPLOAD_IMAGE_MAX_WIDTH=4096
# UPLOAD_IMAGE_MAX_HEIGHT=4096
# UPLOAD_IMAGE_MAX_PIXELS=16777216
# CODE_BLIND_BOX_ENABLED=true

# 说明：REDIS_URL 仅在 compose 里传给容器，当前应用代码未使用 Redis，本地 .env 不必配置。
