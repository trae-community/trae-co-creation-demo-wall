# ========================================
# TRAE Demo Wall - 本地开发环境配置
# ========================================
# 使用方法：复制此文件为 .env.local 并填入实际值
# cp .env.example .env.local
# ========================================

# ----------------------------------------
# Database (PostgreSQL)
# ----------------------------------------
# 如果使用 Docker Compose 启动的数据库服务:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trae_demo_wall?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/trae_demo_wall"

# 如果连接远程数据库或不同端口，请修改主机和端口
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ----------------------------------------
# NextAuth Authentication
# ----------------------------------------
# 生成方式: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------
# Tencent Cloud COS (对象存储)
# ----------------------------------------
# 用于文件上传功能（作品封面、头像等）
COS_SECRET_ID="your-cos-secret-id"
COS_SECRET_KEY="your-cos-secret-key"
COS_BUCKET="your-bucket-name"      # 例如: traedemo-1300167186
COS_REGION="ap-guangzhou"          # 你的 COS 区域，如 ap-beijing, ap-shanghai

# ----------------------------------------
# Redis (可选 - 用于缓存)
# ----------------------------------------
REDIS_URL="redis://localhost:6379"

# ----------------------------------------
# 应用配置
# ----------------------------------------
NODE_ENV="development"
